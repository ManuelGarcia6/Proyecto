"""
--------------- Funciones principales ---------------
"""
def dias_sin_hablar(dia_actual, ultima_interaccion):
    """
    (uso de operadores, uso de funciones)
    recibe: dia_actual (valor numérico), ultima_interaccion (valor numérico)
    resta el día de la última interacción al día actual
    devuelve: días transcurridos, (valor numérico)
    """
    return dia_actual - ultima_interaccion

def dias_para_cumple(dia_actual, dia_cumple):
    """
    (uso de operadores, uso de funciones)
    recibe: dia_actual (valor numérico), dia_cumple (valor númerico)
    resta el día actual al día del cumpleaños
    devuelve: días que faltan para el cumpleaños, (valor numérico)
    """
    return dia_cumple - dia_actual

def es_cumple_este_mes(mes_cumple, mes_actual):
    """
    (uso de operadores de comparación, uso de funciones)
    recibe: mes_cumple (valor numérico), mes_actual (valor numérico)
    compara si el mes del cumpleaños es igual al mes actual
    devuelve: True si coinciden, False si no (booleano)
    """
   return mes_cumple == mes_actual

def mensaje_conexion(nombre, dias_transcurridos):
    """
    (uso de condicionales, uso de funciones)
    recibe: nombre (string), dias_transcurridos (valor numérico)
    si pasaron más de 15 días sin hablar, pone un aviso con los días;
    si no, pone un mensaje de que la conexión está al día
    devuelve: mensaje, (string)
    """
    if dias_transcurridos > 15:
        return "Hace " + str(dias_transcurridos) + " dias que no hablas con " + nombre
    else:
        return "Conexion al dia con " + nombre

"""
--------------- Programa Principal ---------------
"""

dia_actual = 3.0
mes_actual = 9.0

print("Nombre del amigo:")
nombre = input()
print("Día de su cumpleaños (número):")
dia_cumple = float(input())
print("Mes de su cumpleaños (número):")
mes_cumple = float(input())
print("Día del mes de tu ultima interacción (número)")
ultima_interaccion = int(input())

transcurridos = dias_sin_hablar(dia_actual, ultima_interaccion)
faltan = dias_para_cumple(dia_actual, dia_cumple)
mismo_mes = es_cumple_este_mes(mes_cumple, mes_actual)

print(mensaje_conexion(nombre, transcurridos))
print("Dias para su cumpleaños:", faltan)
print("Cumple este mes:", mismo_mes)

print("\n=== MENU PRINCIPAL ===")
print("1. Resumen de conexion")
print("2. Ver si cumple este mes")
print("7. Salir")
print("Elige una opcion:")
opcion = int(input())

if opcion == 1:
    print(mensaje_conexion(nombre, transcurridos))
elif opcion == 2:
    if mismo_mes:
        print(nombre + " cumple este mes")
    else:
        print(nombre + " no cumple este mes")
elif opcion == 7:
    print("Saliendo")
else:
    print("Opcion no valida")
