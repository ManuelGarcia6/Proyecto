    print("4. Actualizar informacion del amigo")
    print("5. Registrar conversacion o saludo")
    print("6. Ver expediente del amigo")
    print("7. Salir")
    print("=" * ANCHO_DEL_MENU)
    print("Elige una opcion:")
    opcion = int(input())
    
    if opcion == 1:
        print(mensaje_conexion(nombre, transcurridos))
    elif opcion == 2:
        if mismo_mes:
            print(nombre + " cumple este mes")
        else:
            print(nombre + " no cumple este mes")
        print("Dias para su birthday:", faltan)
    elif opcion == 3:
        print("Opcion en construccion")
    elif opcion == 4:
        print("Opcion en construccion")
    elif opcion == 5:
        print("Opcion en construccion")
    elif opcion == 6:
        mostrar_expediente(nombre, gustos, alergias, regalos, meta)
    elif opcion == 7:
        print("Saliendo")
    else:
        print("Opcion no valida")

    if opcion != 7:
        print("\nRegresar al menu principal? (s/n)")
        respuesta = input()
        if respuesta == "s" or respuesta == "S":
            mostrar_menu(nombre, transcurridos, faltan, mismo_mes,
                         gustos, alergias, regalos, meta)
        else:
            print("Saliendo")

def mostrar_expediente(nombre, gustos, alergias, regalos, meta):
    """
    (uso de funciones)
    recibe: nombre, gustos, alergias, regalos, meta (strings)
    imprime la informacion personal guardada del amigo
    no devuelve nada
    """
    print("\n" + "-" * ANCHO_DEL_MENU)
    print("EXPEDIENTE DE " + nombre)
    print("-" * ANCHO_DEL_MENU)
    print("Gustos: " + texto_o_vacio(gustos))
    print("Alergias o restricciones: " + texto_o_vacio(alergias))
    print("Regalos pasados: " + texto_o_vacio(regalos))
    print("Meta actual: " + texto_o_vacio(meta))
    print("-" * ANCHO_DEL_MENU)

