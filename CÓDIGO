print("--- Fecha de hoy ---")
dia_actual, mes_actual, anio_actual = pedir_fecha("de hoy")

print("\nNombre del amigo:")
nombre = input()
print("\n--- Cumpleanios ---")
dia_cumple, mes_cumple = pedir_dia_mes("de su cumpleanios")

