# Los datos que forman una cuadricula se guardan en una matriz: el
# calendario del mes (semanas x dias de la semana, enteros).

import calendar

# Constantes del Programa
DIAS_DEL_ANIO = 365
LIMITE_DE_DIAS_SIN_HABLAR = 15
ANCHO_DEL_MENU = 45
OPCION_SALIR = 7
TOTAL_OPCIONES = 7
MESES_DEL_ANIO = 12
ANIO_MINIMO = 1900
ANIO_MAXIMO = 2100
CALENDARIO_RENGLONES = 6
CALENDARIO_COLUMNAS = 7

# Indices de los campos de cada amigo
NOMBRE = 0
DIA_CUMPLE = 1
MES_CUMPLE = 2
GUSTOS = 3
ALERGIAS = 4
REGALOS = 5
META = 6
DIA_ULTIMA = 7
MES_ULTIMA = 8
ANIO_ULTIMA = 9


# --------------- Funciones de fechas ---------------
def dia_del_anio(dia, mes):
    """
    (uso de condicionales, uso de funciones)
    recibe: dia (valor numerico entero),
    mes (valor numerico entero del 1 al 12)
    suma los dias de los meses anteriores al mes dado y le suma el dia
    (se usa un anio de 365 dias, sin bisiestos)
    devuelve: numero de dia del anio entre 1 y 365, (entero)
    """
    if mes == 1:
        acumulado = 0
    elif mes == 2:
        acumulado = 31
    elif mes == 3:
        acumulado = 59
    elif mes == 4:
        acumulado = 90
    elif mes == 5:
        acumulado = 120
    elif mes == 6:
        acumulado = 151
    elif mes == 7:
        acumulado = 181
    elif mes == 8:
        acumulado = 212
    elif mes == 9:
        acumulado = 243
    elif mes == 10:
        acumulado = 273
    elif mes == 11:
        acumulado = 304
    else:
        acumulado = 334
    return acumulado + dia


def dia_absoluto(dia, mes, anio):
    """
    (uso de operadores, uso de funciones)
    recibe: dia, mes, anio (enteros)
    cuenta los dias transcurridos desde el anio 1 hasta la fecha dada,
    usando anios de 365 dias; sirve para restar dos fechas de anios
    distintos
    devuelve: numero de dia absoluto, (entero)
    """
    return (anio - 1) * DIAS_DEL_ANIO + dia_del_anio(dia, mes)


def dias_en_mes(mes):
    """
    (uso de condicionales, uso de funciones)
    recibe: mes (entero del 1 al 12)
    revisa cuantos dias tiene el mes (febrero con 28, sin bisiestos)
    devuelve: dias del mes, (entero)
    """
    if mes == 2:
        return 28
    elif mes == 4 or mes == 6 or mes == 9 or mes == 11:
        return 30
    else:
        return 31


def nombre_del_mes(mes):
    """
    (uso de condicionales, uso de funciones)
    recibe: mes (entero del 1 al 12)
    revisa que numero de mes es y elige su nombre
    devuelve: nombre del mes, (string)
    """
    if mes == 1:
        return "enero"
    elif mes == 2:
        return "febrero"
    elif mes == 3:
        return "marzo"
    elif mes == 4:
        return "abril"
    elif mes == 5:
        return "mayo"
    elif mes == 6:
        return "junio"
    elif mes == 7:
        return "julio"
    elif mes == 8:
        return "agosto"
    elif mes == 9:
        return "septiembre"
    elif mes == 10:
        return "octubre"
    elif mes == 11:
        return "noviembre"
    else:
        return "diciembre"


def dias_sin_hablar(dia_actual, mes_actual, anio_actual,
                    dia_ultima, mes_ultima, anio_ultima):
    """
    (uso de operadores, uso de funciones)
    recibe: fecha de hoy y fecha de la ultima interaccion
    (dia, mes y anio de cada una, enteros)
    resta el dia absoluto de la ultima interaccion al de hoy
    devuelve: dias transcurridos, (entero, negativo si la ultima
    interaccion es posterior a hoy)
    """
    hoy = dia_absoluto(dia_actual, mes_actual, anio_actual)
    ultima = dia_absoluto(dia_ultima, mes_ultima, anio_ultima)
    return hoy - ultima


def dias_para_cumple(dia_actual, mes_actual, dia_cumple, mes_cumple):
    """
    (uso de operadores, uso de condicionales, uso de funciones)
    recibe: dia_actual, mes_actual, dia_cumple, mes_cumple (enteros)
    resta el dia del anio de hoy al dia del anio del cumpleanios;
    si el resultado es negativo, el cumpleanios ya paso y se cuenta el
    del anio siguiente sumando 365
    devuelve: dias que faltan para el cumpleanios, (entero)
    """
    hoy = dia_del_anio(dia_actual, mes_actual)
    cumple = dia_del_anio(dia_cumple, mes_cumple)
    faltan = cumple - hoy
    if faltan < 0:
        faltan = faltan + DIAS_DEL_ANIO
    return faltan


# --------------- Funciones de mensajes ---------------
def mensaje_conexion(nombre, dias_transcurridos):
    """
    (uso de condicionales, uso de funciones)
    recibe: nombre (string), dias_transcurridos (valor numerico)
    si pasaron mas de 15 dias sin hablar, pone un aviso con los dias;
    si no, pone un mensaje de que la conexion esta al dia
    devuelve: mensaje, (string)
    """
    if dias_transcurridos > LIMITE_DE_DIAS_SIN_HABLAR:
        return ("Hace " + str(dias_transcurridos)
                + " dias que no hablas con " + nombre)
    else:
        return "Conexion al dia con " + nombre


def texto_o_vacio(texto):
    """
    (uso de condicionales, uso de funciones)
    recibe: texto (string)
    revisa si el texto esta vacio
    devuelve: "Sin registrar" si esta vacio, o el mismo texto si no (string)
    """
    if texto == "":
        return "Sin registrar"
    else:
        return texto


def unir_texto(texto_actual, texto_nuevo):
    """
    (uso de condicionales, uso de funciones)
    recibe: texto_actual (string), texto_nuevo (string)
    agrega el texto nuevo al final separado por coma; si el texto actual
    esta vacio, devuelve solo el nuevo
    devuelve: texto unido, (string)
    """
    if texto_actual == "":
        return texto_nuevo
    else:
        return texto_actual + ", " + texto_nuevo


# --------------- Funciones de entrada con validacion (while) ---------------
def pedir_entero(mensaje, minimo, maximo):
    """
    (uso de ciclo while, uso de funciones)
    recibe: mensaje (string), minimo (entero), maximo (entero)
    muestra el mensaje y lee un texto; mientras no sea un numero entero
    dentro del rango, avisa del error y vuelve a preguntar
    (se revisa con isdecimal() antes de convertir, asi un texto como
    "abc" o un Enter vacio no truena el programa)
    devuelve: numero valido entre minimo y maximo, (entero)
    """
    print(mensaje)
    texto = input()
    while (not texto.isdecimal()
           or int(texto) < minimo or int(texto) > maximo):
        print("Valor no valido, escribe un numero entre "
              + str(minimo) + " y " + str(maximo))
        print(mensaje)
        texto = input()
    return int(texto)


def pedir_texto(mensaje):
    """
    (uso de ciclo while, uso de funciones)
    recibe: mensaje (string)
    muestra el mensaje y lee un texto; mientras este vacio, vuelve a
    preguntar
    devuelve: texto no vacio, (string)
    """
    print(mensaje)
    texto = input()
    while texto == "":
        print("Este dato no puede quedar vacio.")
        print(mensaje)
        texto = input()
    return texto


def pedir_dia_mes(descripcion):
    """
    (uso de funciones, funcion que llama a otra funcion con while)
    recibe: descripcion (string), por ejemplo "de su cumpleanios"
    pide primero el dia (1 a 31) y despues el mes; como el dia se captura
    antes que el mes, un ciclo while revisa que el dia exista en ese mes
    y, si no, vuelve a pedir ambos
    devuelve: dia y mes validos, (dos enteros)
    """
    dia = pedir_entero("Dia " + descripcion + " (1 a 31):", 1, 31)
    mes = pedir_entero("Mes " + descripcion + " (1 a 12):",
                       1, MESES_DEL_ANIO)
    while dia > dias_en_mes(mes):
        print("Ese mes no tiene " + str(dia) + " dias, "
              + "escribe la fecha de nuevo.")
        dia = pedir_entero("Dia " + descripcion + " (1 a 31):", 1, 31)
        mes = pedir_entero("Mes " + descripcion + " (1 a 12):",
                           1, MESES_DEL_ANIO)
    return dia, mes


def pedir_fecha(descripcion):
    """
    (uso de funciones, funcion que llama a otra funcion con while)
    recibe: descripcion (string), por ejemplo "de hoy"
    pide mes, dia y anio validos de una fecha completa
    devuelve: dia, mes y anio, (tres enteros)
    """
    dia, mes = pedir_dia_mes(descripcion)
    anio = pedir_entero("Anio " + descripcion + " (ej. 2026):",
                        ANIO_MINIMO, ANIO_MAXIMO)
    return dia, mes, anio


# --------------- Funciones de la lista de amigos ---------------
def buscar_indice(amigos, nombre):
    """
    (uso de listas, uso de listas anidadas, ciclo for, uso de funciones)
    recibe: amigos (lista de listas), nombre (string)
    recorre la lista comparando el nombre de cada amigo con el buscado,
    sin importar mayusculas o minusculas
    devuelve: posicion del amigo en la lista, o -1 si no esta (entero)
    """
    for i in range(len(amigos)):
        if amigos[i][NOMBRE].lower() == nombre.lower():
            return i
    return -1


def pedir_indice_amigo(amigos):
    """
    (uso de listas, uso de funciones)
    recibe: amigos (lista de listas)
    pide el nombre de un amigo y lo busca en la lista; si no existe,
    avisa
    devuelve: posicion del amigo en la lista, o -1 si no esta (entero)
    """
    print("Nombre del amigo:")
    nombre = input()
    indice = buscar_indice(amigos, nombre)
    if indice == -1:
        print("No se encontro a " + nombre + ".")
    return indice


def registrar_interaccion(amigo, dia, mes, anio):
    """
    (uso de listas, uso de funciones)
    recibe: amigo (lista), dia, mes, anio (enteros)
    guarda la fecha dada como ultima interaccion del amigo
    no devuelve nada
    """
    amigo[DIA_ULTIMA] = dia
    amigo[MES_ULTIMA] = mes
    amigo[ANIO_ULTIMA] = anio


def dias_sin_hablar_amigo(amigo, dia_actual, mes_actual, anio_actual):
    """
    (uso de listas, uso de funciones)
    recibe: amigo (lista), fecha de hoy (tres enteros)
    calcula los dias desde la ultima interaccion guardada en el amigo
    devuelve: dias transcurridos, (entero)
    """
    return dias_sin_hablar(dia_actual, mes_actual, anio_actual,
                           amigo[DIA_ULTIMA], amigo[MES_ULTIMA],
                           amigo[ANIO_ULTIMA])


# --------------- Funciones de matrices ---------------
def crear_matriz(renglones, columnas, valor):
    """
    (uso de listas anidadas, ciclos anidados, uso de funciones)
    recibe: renglones (entero), columnas (entero), valor (cualquier dato)
    crea una matriz de renglones x columnas con el valor en cada celda;
    cada renglon se arma por separado para que sean listas distintas
    devuelve: matriz, (lista de listas)
    """
    matriz = []
    for ren in range(renglones):
        renglon = []
        for col in range(columnas):
            renglon.append(valor)
        matriz.append(renglon)
    return matriz


def crear_calendario(mes, anio):
    """
    (uso de matrices, ciclo for, uso de condicionales, uso de funciones)
    recibe: mes (entero del 1 al 12), anio (entero)
    crea una matriz de 6 renglones (semanas) x 7 columnas (lunes a
    domingo) y coloca cada dia del mes en su celda; las celdas sin dia
    quedan en 0. La biblioteca calendar solo se usa para saber en que
    dia de la semana empieza el mes (0 = lunes) y cuantos dias tiene
    devuelve: calendario, (matriz de enteros)
    """
    primer_dia, total_dias = calendar.monthrange(anio, mes)
    calendario = crear_matriz(CALENDARIO_RENGLONES,
                              CALENDARIO_COLUMNAS, 0)
    renglon = 0
    columna = primer_dia
    for dia in range(1, total_dias + 1):
        calendario[renglon][columna] = dia
        columna = columna + 1
        if columna == CALENDARIO_COLUMNAS:
            columna = 0
            renglon = renglon + 1
    return calendario


def hay_cumple_en_dia(amigos, dia, mes):
    """
    (uso de listas, ciclo for, uso de funciones)
    recibe: amigos (lista de listas), dia y mes (enteros)
    revisa si algun amigo cumple anios en esa fecha
    devuelve: True si hay alguno, False si no (booleano)
    """
    for amigo in amigos:
        if amigo[DIA_CUMPLE] == dia and amigo[MES_CUMPLE] == mes:
            return True
    return False


def mostrar_calendario(calendario, amigos, mes, anio):
    """
    (uso de matrices, ciclos anidados, condicionales, uso de funciones)
    recibe: calendario (matriz de enteros), amigos (lista de listas),
    mes y anio (enteros)
    imprime la matriz como cuadricula de lunes a domingo y marca con un
    asterisco los dias en que algun amigo cumple anios
    no devuelve nada
    """
    print("\n" + nombre_del_mes(mes) + " " + str(anio))
    print("Lu  Ma  Mi  Ju  Vi  Sa  Do")
    for ren in range(CALENDARIO_RENGLONES):
        linea = ""
        for col in range(CALENDARIO_COLUMNAS):
            dia = calendario[ren][col]
            if dia == 0:
                celda = "    "
            elif hay_cumple_en_dia(amigos, dia, mes):
                celda = str(dia).rjust(2) + "* "
            else:
                celda = str(dia).rjust(2) + "  "
            linea = linea + celda
        if linea.strip() != "":
            print(linea.rstrip())
    print("* = cumpleanios")


