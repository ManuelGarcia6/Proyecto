#Proyecto Ágape - Avance 3

def dias_sin_hablar(dia_actual, ultima_interaccion):
    return dia_actual - ultima_interaccion

def dias_para_cumple(dia_actual, dia_cumple):
    return dia_cumple - dia_actual

def es_cumple_este_mes(mes_cumple, mes_actual):
    return mes_cumple == mes_actual

def mensaje_conexion(nombre, dias_transcurridos):
    if dias_transcurridos > 15:
        return "Hace " + str(dias_transcurridos) + " dias que no hablas con " + nombre
    else:
        return "Conexion al dia con " + nombre

dia_actual = 3.0
mes_actual = 9.0

nombre = input()
dia_cumple = float(input())
mes_cumple = float(input())
ultima_interaccion = float(input())

transcurridos = dias_sin_hablar(dia_actual, ultima_interaccion)
faltan = dias_para_cumple(dia_actual, dia_cumple)
mismo_mes = es_cumple_este_mes(mes_cumple, mes_actual)

print(mensaje_conexion(nombre, transcurridos))
print(faltan)
print(mismo_mes)

opcion = int(input())

if opcion == 1:
    print(mensaje_conexion(nombre, transcurridos))
elif opcion == 2:
    if mismo_mes:
        print(nombre + " cumple este mes")
    else:
        print(nombre + " no cumple este mes")
elif opcion == 7:
    print("Saliendo")
else:
    print("Opcion no valida")
